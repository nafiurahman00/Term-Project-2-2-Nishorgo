# Supabase project (Dashboard → Project Settings → API). Both values are public.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=

# PHP API. Leave unset in dev to use the Vite proxy (/api → http://localhost:8000).
# VITE_API_URL=https://api.your-domain.com/api

# Show the one-click demo account buttons on the login page (demo seed only).
VITE_SHOW_DEMO_ACCOUNTS=true
