APP_NAME=Nishorgo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Supabase Postgres -------------------------------------------------------
# Dashboard → Connect → "Session pooler" (or Direct) connection string.
# The API impersonates users with `set local role authenticated`, so it must
# connect as the `postgres` user (the default in that string).
DB_CONNECTION=pgsql
DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SSLMODE=require

# --- Supabase Auth -----------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Only needed for legacy HS256 projects (Settings → API → JWT secret).
# New projects use asymmetric signing keys fetched from the JWKS endpoint.
SUPABASE_JWT_SECRET=

# --- Stripe (test mode) ------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to use built-in demo payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bdt
DEMO_PAYMENTS=true

FRONTEND_URL=http://localhost:5173

# --- Stateless API: no sessions/queues/db cache needed -------------------------
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
